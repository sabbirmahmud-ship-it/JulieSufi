{{ 'section-jf-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign fetch_priority = 'auto'
  assign intro_mobile = section.settings.mobile_intro_text | strip_html | strip
  assign intro_desktop = section.settings.intro_text | strip_html | strip
  assign use_separate_mobile_intro = false
  assign form_id = 'JfContactForm-' | append: section.id

  if intro_mobile != blank and intro_mobile != intro_desktop
    assign use_separate_mobile_intro = true
  endif

  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #JfContact-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    --jf-contact-card-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --jf-contact-card-gap-desktop: {{ section.settings.card_gap_desktop }}px;
  }

  #JfContact-{{ section.id }} .jf-contact__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #JfContact-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    #JfContact-{{ section.id }} .jf-contact__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfContact-{{ section.id }}" class="jf-contact">
  {%- if fallback_background_image != blank -%}
    <div class="jf-contact__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            fetchpriority: fetch_priority
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-contact__inner page-width">
    <div class="jf-contact__container">
      <div class="jf-contact__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="jf-contact__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if use_separate_mobile_intro -%}
          <div class="jf-contact__intro-copy jf-contact__intro-copy--mobile">{{ section.settings.mobile_intro_text }}</div>
          <div class="jf-contact__intro-copy jf-contact__intro-copy--desktop">{{ section.settings.intro_text }}</div>
        {%- elsif section.settings.intro_text != blank -%}
          <div class="jf-contact__intro-copy">{{ section.settings.intro_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="jf-contact__cards">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_text = block.settings.content | strip_html | strip
              assign use_custom_icon = false

              if block.settings.icon_style == 'custom' and block.settings.custom_icon != blank
                assign use_custom_icon = true
              endif
            -%}

            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="jf-contact__card"
                aria-label="{{ card_text | escape }}"
                {{ block.shopify_attributes }}
              >
            {%- else -%}
              <article class="jf-contact__card" {{ block.shopify_attributes }}>
            {%- endif -%}
                <div class="jf-contact__card-icon">
                  {%- if use_custom_icon -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 120
                      | image_tag:
                        widths: '40, 60, 80, 120',
                        sizes: '(min-width: 750px) 20px, 20px',
                        loading: 'lazy',
                        alt: block.settings.custom_icon.alt
                    }}
                  {%- else -%}
                    {%- case block.settings.icon_style -%}
                      {%- when 'instagram' -%}
                        {{ 'icon-instagram.svg' | inline_asset_content }}
                      {%- when 'calendar' -%}
                        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                          <g fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.4">
                            <path d="M4.25 5.5h11.5v10.25H4.25z"/>
                            <path d="M4.25 8.25h11.5"/>
                            <path d="M6.75 3.75v3"/>
                            <path d="M13.25 3.75v3"/>
                            <path d="M7.25 11.5h2.5"/>
                          </g>
                        </svg>
                      {%- else -%}
                        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                          <g fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M3.75 5.75h12.5v8.5H3.75z"/>
                            <path d="m4.25 6.25 5.75 4.5 5.75-4.5" stroke-linecap="square" stroke-linejoin="miter"/>
                          </g>
                        </svg>
                    {%- endcase -%}
                  {%- endif -%}
                </div>

                {%- if block.settings.content != blank -%}
                  <div class="jf-contact__card-copy">{{ block.settings.content }}</div>
                {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'jf-contact__form' -%}
        {%- if section.settings.recipient_emails != blank -%}
          <input type="hidden" name="contact[Recipient emails]" value="{{ section.settings.recipient_emails | escape }}">
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="jf-contact__status jf-contact__status--success" tabindex="-1" autofocus>
            <h3 class="jf-contact__status-title">{{ section.settings.success_heading | escape }}</h3>
            <div class="jf-contact__status-copy">
              {%- if section.settings.success_message != blank -%}
                <p>{{ section.settings.success_message | escape }}</p>
              {%- else -%}
                <p>{{ 'templates.contact.form.post_success' | t }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- elsif form.errors -%}
          <div class="jf-contact__status jf-contact__status--error" tabindex="-1" autofocus>
            <h3 class="jf-contact__status-title">{{ section.settings.error_heading | escape }}</h3>
            <div class="jf-contact__status-copy">
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        <div class="jf-contact__fields">
          <div class="jf-contact__field jf-contact__field--full">
            <label class="jf-contact__label" for="JfContact-name-{{ section.id }}">
              {{ section.settings.name_label | escape }}
            </label>
            <input
              id="JfContact-name-{{ section.id }}"
              class="jf-contact__input"
              type="text"
              name="contact[Name]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ section.settings.name_placeholder | escape }}"
            >
          </div>

          <div class="jf-contact__field">
            <label class="jf-contact__label" for="JfContact-email-{{ section.id }}">
              {{ section.settings.email_label | escape }}
            </label>
            <input
              id="JfContact-email-{{ section.id }}"
              class="jf-contact__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}
            >
          </div>

          <div class="jf-contact__field">
            <label class="jf-contact__label" for="JfContact-phone-{{ section.id }}">
              {{ section.settings.phone_label | escape }}
            </label>
            <input
              id="JfContact-phone-{{ section.id }}"
              class="jf-contact__input"
              type="tel"
              name="contact[Phone]"
              autocomplete="tel"
              inputmode="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ section.settings.phone_placeholder | escape }}"
            >
          </div>

          <div class="jf-contact__field jf-contact__field--full">
            <label class="jf-contact__label" for="JfContact-subject-{{ section.id }}">
              {{ section.settings.subject_label | escape }}
            </label>
            <input
              id="JfContact-subject-{{ section.id }}"
              class="jf-contact__input"
              type="text"
              name="contact[Subject]"
              value="{{ form.subject }}"
              placeholder="{{ section.settings.subject_placeholder | escape }}"
            >
          </div>

          <div class="jf-contact__field jf-contact__field--full">
            <label class="jf-contact__label" for="JfContact-message-{{ section.id }}">
              <span>{{ section.settings.message_label | escape }}</span>
              {%- if section.settings.message_optional_label != blank -%}
                <span class="jf-contact__label-optional">{{ section.settings.message_optional_label | escape }}</span>
              {%- endif -%}
            </label>
            <textarea
              id="JfContact-message-{{ section.id }}"
              class="jf-contact__textarea"
              name="contact[body]"
              rows="6"
              placeholder="{{ section.settings.message_placeholder | escape }}"
            >{{- form.body -}}</textarea>
          </div>
        </div>

        <div class="jf-contact__actions">
          <button type="submit" class="jf-contact__button">
            {{ section.settings.button_label | escape }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JF Contact",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE'D LOVE TO HEAR FROM YOU"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Desktop intro text",
      "default": "<p>Whether You're Beginning Or Simply Exploring.</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_intro_text",
      "label": "Mobile intro text",
      "info": "Optional. Leave blank to use the desktop intro text on mobile."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "textarea",
      "id": "recipient_emails",
      "label": "Recipient emails",
      "info": "Shopify's native contact form still sends to the store sender email. Add comma-separated emails here for reference or for store-level forwarding workflows."
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "Message Sent"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for contacting us. We'll get back to you as soon as possible."
    },
    {
      "type": "text",
      "id": "error_heading",
      "label": "Error heading",
      "default": "Please adjust the following:"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "FULL NAME"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "e.g Jhon Doe"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "EMAIL"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "e.g.jhon.doe@gmail.com"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "PHONE"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "e.g +1 (234) 567 890"
    },
    {
      "type": "text",
      "id": "subject_label",
      "label": "Subject label",
      "default": "SUBJECT"
    },
    {
      "type": "text",
      "id": "subject_placeholder",
      "label": "Subject placeholder",
      "default": "e.g Jhon Doe"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "MESSAGE"
    },
    {
      "type": "text",
      "id": "message_optional_label",
      "label": "Message optional label",
      "default": "(OPTIONAL)"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us what you're looking for or how we can help..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SEND MESSAGE"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Mobile gap between contact boxes",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "label": "Desktop gap between contact boxes",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Mobile top margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Mobile bottom margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Desktop top margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Desktop bottom margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "contact_method",
      "name": "Contact method",
      "settings": [
        {
          "type": "select",
          "id": "icon_style",
          "label": "Icon",
          "default": "email",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "calendar",
              "label": "Calendar"
            },
            {
              "value": "custom",
              "label": "Custom image"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Email us for general enquiries:<br><strong>contact@juliesufi.com</strong></p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Contact",
      "blocks": [
        {
          "type": "contact_method",
          "settings": {
            "icon_style": "email",
            "content": "<p>Email us for general enquiries:<br><strong>contact@juliesufi.com</strong></p>"
          }
        },
        {
          "type": "contact_method",
          "settings": {
            "icon_style": "instagram",
            "content": "<p>Send us a DM on Instagram<br><strong>and we'll respond shortly.</strong></p>"
          }
        },
        {
          "type": "contact_method",
          "settings": {
            "icon_style": "calendar",
            "content": "<p>For Custom Bridal Enquiries<br><strong>Book Appointment</strong></p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
