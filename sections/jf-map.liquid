{{ 'section-jf-map.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #JfMap-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
  }

  #JfMap-{{ section.id }} .jf-map__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #JfMap-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    #JfMap-{{ section.id }} .jf-map__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfMap-{{ section.id }}" class="jf-map">
  {%- if fallback_background_image != blank -%}
    <div class="jf-map__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            fetchpriority: fetch_priority
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-map__inner page-width">
    <div class="jf-map__container">
      <div class="jf-map__map">
        <div class="jf-map__map-frame global-media-settings">
          {%- if section.settings.map_embed != blank -%}
            {{ section.settings.map_embed }}
          {%- elsif request.design_mode -%}
            <div class="jf-map__map-placeholder">
              Paste the Google Maps embed iframe into the "Map embed code" setting.
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="jf-map__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="jf-map__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.address != blank -%}
          <div class="jf-map__group">{{ section.settings.address }}</div>
        {%- endif -%}

        {%- if section.settings.opening_hours != blank -%}
          <div class="jf-map__group">{{ section.settings.opening_hours }}</div>
        {%- endif -%}

        {%- if section.settings.consultation_text != blank -%}
          <div class="jf-map__group jf-map__group--consultation">{{ section.settings.consultation_text }}</div>
        {%- endif -%}

        {%- if section.settings.order_enquiries_label != blank or section.settings.order_enquiries_email != blank -%}
          <div class="jf-map__group">
            {%- if section.settings.order_enquiries_label != blank -%}
              <p class="jf-map__group-label">{{ section.settings.order_enquiries_label | escape }}</p>
            {%- endif -%}

            {%- if section.settings.order_enquiries_email != blank -%}
              <p>
                <a
                  class="jf-map__contact-link jf-map__contact-link--emphasis"
                  href="mailto:{{ section.settings.order_enquiries_email | escape }}"
                >
                  {{ section.settings.order_enquiries_email | escape }}
                </a>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.general_enquiries_label != blank or section.settings.general_enquiries_email != blank or section.settings.phone_number != blank -%}
          <div class="jf-map__group">
            {%- if section.settings.general_enquiries_label != blank -%}
              <p class="jf-map__group-label">{{ section.settings.general_enquiries_label | escape }}</p>
            {%- endif -%}

            <div class="jf-map__contact-links">
              {%- if section.settings.general_enquiries_email != blank -%}
                <a class="jf-map__contact-link" href="mailto:{{ section.settings.general_enquiries_email | escape }}">
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <g fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M3.75 5.75h12.5v8.5H3.75z"/>
                      <path d="m4.25 6.25 5.75 4.5 5.75-4.5" stroke-linecap="square" stroke-linejoin="miter"/>
                    </g>
                  </svg>
                  <span>{{ section.settings.general_enquiries_email | escape }}</span>
                </a>
              {%- endif -%}

              {%- if section.settings.general_insta_dm != blank -%}
                <a class="jf-map__contact-link" href="{{ section.settings.general_insta_dm | escape }}">
                  {{ 'icon-instagram.svg' | inline_asset_content }}
                  <span>Instagram DM</span>
                </a>
              {%- endif -%}

              {%- if section.settings.phone_number != blank -%}
                <a
                  class="jf-map__contact-link"
                  href="tel:{{ section.settings.phone_number | strip | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}"
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4">
                      <path d="M6.19 3.75h2.08l1.04 3.13-1.3 1.56a11.32 11.32 0 0 0 3.55 3.55l1.56-1.3 3.13 1.04v2.08c0 .57-.46 1.03-1.03 1.03A11.72 11.72 0 0 1 4.16 4.78c0-.57.46-1.03 1.03-1.03Z"/>
                    </g>
                  </svg>
                  <span>{{ section.settings.phone_number | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JF Map",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CONTACT US"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Jessie St, Northcote<br>VIC 3070, Australia</p>"
    },
    {
      "type": "richtext",
      "id": "opening_hours",
      "label": "Opening hours",
      "default": "<p>Monday 10am - 6pm</p><p>Tuesday To Thursday 10am - 7pm</p><p>Friday To Saturday 10am - 6pm</p><p>Sunday 10am - 4pm</p>"
    },
    {
      "type": "richtext",
      "id": "consultation_text",
      "label": "Consultation text",
      "default": "<p><strong>Free Initial Virtual Consultation</strong></p>"
    },
    {
      "type": "text",
      "id": "order_enquiries_label",
      "label": "Order enquiries label",
      "default": "Order, Appointment And Leadtime Enquiries:"
    },
    {
      "type": "text",
      "id": "order_enquiries_email",
      "label": "Order enquiries email",
      "default": "enquiries@Juliesufi.Com"
    },
    {
      "type": "text",
      "id": "general_enquiries_label",
      "label": "General enquiries label",
      "default": "General Enquiries:"
    },
    {
      "type": "text",
      "id": "general_enquiries_email",
      "label": "General enquiries email",
      "default": "Contact@Juliesufi.Com"
    },
    {
      "type": "text",
      "id": "general_insta_dm",
      "label": "Instagram DM Link",
      "default": "https://www.instagram.com/juliesufi/"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "+44 20 4566 5755"
    },
    {
      "type": "liquid",
      "id": "map_embed",
      "label": "Map embed code",
      "info": "Paste the full Google Maps iframe embed code."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Mobile top margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Mobile bottom margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Desktop top margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Desktop bottom margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "JF Map"
    }
  ]
}
{% endschema %}
