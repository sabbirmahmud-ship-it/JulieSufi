{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'section-jf-image-slider.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'section-jf-image-slider.css' | asset_url | stylesheet_tag }}</noscript>
{%- else -%}
  {{ 'section-jf-image-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign show_controls = false
  assign fetch_priority = 'low'

  if section.blocks.size > 4
    assign show_controls = true
  endif

  if section.index == 1
    assign fetch_priority = 'high'
  elsif section.index == 2
    assign fetch_priority = 'auto'
  endif
-%}

{%- style -%}
  #JfImageSlider-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
  }

  #JfImageSlider-{{ section.id }} .jf-image-slider__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #JfImageSlider-{{ section.id }} .jf-image-slider__track {
    --jf-image-slider-gap: {{ section.settings.slide_gap }}px;
  }

  @media screen and (min-width: 750px) {
    #JfImageSlider-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
    }

    #JfImageSlider-{{ section.id }} .jf-image-slider__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<jf-image-slider id="JfImageSlider-{{ section.id }}" class="jf-image-slider">
  {%- if fallback_background_image != blank -%}
    <div class="jf-image-slider__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            fetchpriority: fetch_priority
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-image-slider__inner page-width">
    <div class="jf-image-slider__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jf-image-slider__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="jf-image-slider__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="jf-image-slider__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="jf-image-slider__viewport">
      <ul
        class="jf-image-slider__track list-unstyled{% unless show_controls %} jf-image-slider__track--desktop-grid{% endunless %}"
        data-slider-track
      >
        {%- for block in section.blocks -%}
          <li class="jf-image-slider__slide" id="Slide-{{ section.id }}-{{ forloop.index }}" data-slider-slide {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="jf-image-slider__link">
            {%- else -%}
              <div class="jf-image-slider__link">
            {%- endif -%}
              <div class="jf-image-slider__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      widths: '240, 360, 480, 550, 660, 750, 900',
                      sizes: '(min-width: 750px) 25vw, 75vw',
                      loading: 'lazy',
                      fetchpriority: 'low',
                      alt: block.settings.image.alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

                {%- if block.settings.label != blank -%}
                  <span class="jf-image-slider__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_controls -%}
        <div class="jf-image-slider__controls">
          <div class="jf-image-slider__dots" data-slider-dots></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</jf-image-slider>

{%- if section.index > 2 and request.design_mode != true -%}
  <script>
    (() => {
      const section = document.currentScript.previousElementSibling;
      const src = {{ 'section-jf-image-slider.js' | asset_url | json }};

      const loadScript = () => {
        if (document.querySelector(`script[src="${src}"]`)) return;

        const script = document.createElement('script');
        script.src = src;
        script.defer = true;
        document.head.appendChild(script);
      };

      if (!section || !('IntersectionObserver' in window)) {
        loadScript();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0] || !entries[0].isIntersecting) return;
          observer.disconnect();
          loadScript();
        },
        {rootMargin: '300px 0px'}
      );

      observer.observe(section);
    })();
  </script>
{%- else -%}
  <script src="{{ 'section-jf-image-slider.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "JF Image Slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inside the Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Gown is Handcrafted"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Defined by precision, intention, and detail.</p>"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#f7f4f0"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#f7f4f0"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between slides",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Personal, Precise, Couture"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Image Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "label": "Personal, Precise, Couture"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "Detail, Defined"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "A Dress Takes Shape"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "The Final Fitting"
          }
        }
      ]
    }
  ]
}
{% endschema %}
