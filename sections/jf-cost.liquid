{{ 'section-jf-cost.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #JfCost-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #JfCost-{{ section.id }} .jf-cost__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #JfCost-{{ section.id }} .jf-cost__button {
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (min-width: 750px) {
    #JfCost-{{ section.id }} .jf-cost__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfCost-{{ section.id }}" class="jf-cost">
  <div class="jf-cost__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="jf-cost__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="jf-cost__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="jf-cost__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="jf-cost__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="jf-cost__rows">
        {%- for block in section.blocks -%}
          <div class="jf-cost__row jf-cost__row--image-{{ block.settings.image_position }}" {{ block.shopify_attributes }}>
            <div class="jf-cost__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '375, 550, 750, 900, 1100, 1400',
                    sizes: '(min-width: 990px) 48vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="jf-cost__content">
              {%- if block.settings.heading != blank -%}
                <h3 class="jf-cost__item-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.price != blank -%}
                <p class="jf-cost__price">{{ block.settings.price | escape }}</p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="jf-cost__description rte">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.feature_1_heading != blank or block.settings.feature_2_heading != blank or block.settings.feature_3_heading != blank -%}
                <div class="jf-cost__features">
                  {%- for index in (1..3) -%}
                    {%- liquid
                      assign heading_key = 'feature_' | append: index | append: '_heading'
                      assign text_key = 'feature_' | append: index | append: '_text'
                      assign feature_heading = block.settings[heading_key]
                      assign feature_text = block.settings[text_key]
                    -%}

                    {%- if feature_heading != blank or feature_text != blank -%}
                      <div class="jf-cost__feature">
                        <span class="jf-cost__feature-icon" aria-hidden="true">
                          <svg viewBox="0 0 16 16" focusable="false">
                            <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.2"/>
                            <path d="M5.1 8.2 7 10.1 11 6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        <div class="jf-cost__feature-copy">
                          {%- if feature_heading != blank -%}
                            <p class="jf-cost__feature-heading">{{ feature_heading | escape }}</p>
                          {%- endif -%}

                          {%- if feature_text != blank -%}
                            <div class="jf-cost__feature-text rte">{{ feature_text }}</div>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.promise_text != blank -%}
      <div class="jf-cost__promise rte">{{ section.settings.promise_text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="jf-cost__footer">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="jf-cost__button"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "JF Cost",
  "settings": [
    {
      "type": "header",
      "content": "Top content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CUSTOM WEDDING DRESSES COST & VALUE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Investing in The One Day & Forever: Pricing & Tiers"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>A Julie Sufi custom wedding dress Melbourne is an investment in both a momentous day and a permanent legacy. Unlike off-the-rack bridal shopping-where the price of the gown is often just the starting point-our pricing is comprehensive, reflecting the thousands of artisan hours forging your handmade wedding dress.</p>"
    },
    {
      "type": "header",
      "content": "Promise"
    },
    {
      "type": "richtext",
      "id": "promise_text",
      "label": "Promise text",
      "default": "<p><strong>Our Promise:</strong> We provide a finalized, fixed-price quote following your initial design dialogue. There are no external charges-only the certainty of a masterpiece delivered to your exact specifications.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Font color",
      "default": "#232128"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#1f1f23"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "cost_row",
      "name": "Cost row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Desktop image position",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Julie Sufi Bespoke Couture Price Range"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "Starting from AU$5,000"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Designed for the bride seeking minimalist elegance and architectural purity. This tier focuses on superior fabric choice and our signature internal construction, featuring clean lines and a flawlessly sculpted silhouette.</p>"
        },
        {
          "type": "header",
          "content": "Checklist item 1"
        },
        {
          "type": "text",
          "id": "feature_1_heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "feature_1_text",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Checklist item 2"
        },
        {
          "type": "text",
          "id": "feature_2_heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "feature_2_text",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Checklist item 3"
        },
        {
          "type": "text",
          "id": "feature_3_heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "feature_3_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Cost",
      "blocks": [
        {
          "type": "cost_row",
          "settings": {
            "image_position": "left",
            "heading": "Julie Sufi Bespoke Couture Price Range",
            "price": "Starting from AU$5,000",
            "description": "<p>Designed for the bride seeking minimalist elegance and architectural purity. This tier focuses on superior fabric choice (such as heavy-weight crepes or Italian Mikado) and our signature internal construction, featuring clean lines and a flawlessly sculpted silhouette.</p>"
          }
        },
        {
          "type": "cost_row",
          "settings": {
            "image_position": "right",
            "heading": "Julie Sufi High Couture Price Range",
            "price": "Starting from AU$8,000",
            "description": "<p>Designed for the bride seeking intricate complexity. This tier includes couture bridal dresses featuring intensive hand-detailing, multi-layered French laces, elaborate beadwork, or significant structural elements like expansive detachable overskirts and cathedral-length extensions.</p>"
          }
        },
        {
          "type": "cost_row",
          "settings": {
            "image_position": "left",
            "heading": "Begin with the Final Cost",
            "price": "",
            "description": "<p>One of the most significant benefits of the couture path is the elimination of the hidden costs associated with traditional bridal boutiques.</p>",
            "feature_1_heading": "Starting from AU$8,000",
            "feature_1_text": "<p>Standard bridal shops often charge between AU$800 and AU$1,500 for post-purchase alterations. At Julie Sufi, your gown is built to your measurements from day one.</p>",
            "feature_2_heading": "Unlimited Fittings",
            "feature_2_text": "<p>Your first price outline includes every fitting required-from the initial calico Toile mock-up to the final silk refinement.</p>",
            "feature_3_heading": "Direct Accountability",
            "feature_3_text": "<p>You are not paying for showroom markups or retail overhead. Every dollar of your investment stays within our Melbourne atelier, and so does the responsibility for the master-craftsmanship of your custom wedding dress.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
