{{ 'section-jf-plain-box-icon.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
-%}

{%- style -%}
  #JfPlainBoxIcon-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
  }

  #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__grid {
    --jf-plain-box-icon-columns-mobile: {{ section.settings.columns_mobile }};
    --jf-plain-box-icon-columns-desktop: {{ section.settings.columns_desktop }};
    --jf-plain-box-icon-row-gap: {{ section.settings.row_gap }}px;
  }

  #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__item::before {
    display: none;
  }

  {%- if section.settings.columns_mobile > 1 -%}
    #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__item:not(:nth-child({{ section.settings.columns_mobile }}n + 1))::before {
      display: block;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    #JfPlainBoxIcon-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
    }

    #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__item::before {
      display: none;
    }

    {%- if section.settings.columns_desktop > 1 -%}
      #JfPlainBoxIcon-{{ section.id }} .jf-plain-box-icon__item:not(:nth-child({{ section.settings.columns_desktop }}n + 1))::before {
        display: block;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<section id="JfPlainBoxIcon-{{ section.id }}" class="jf-plain-box-icon">
  {%- if fallback_background_image != blank -%}
    <div class="jf-plain-box-icon__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy'
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-plain-box-icon__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="jf-plain-box-icon__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="jf-plain-box-icon__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="jf-plain-box-icon__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="jf-plain-box-icon__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="jf-plain-box-icon__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_link = block.settings.link
          assign title_text = block.settings.title | escape
        -%}
        <article class="jf-plain-box-icon__item" {{ block.shopify_attributes }}>
          {%- if block_link != blank -%}
            <a href="{{ block_link }}" class="jf-plain-box-icon__card" aria-label="{{ title_text }}">
          {%- else -%}
            <div class="jf-plain-box-icon__card">
          {%- endif -%}

          <div class="jf-plain-box-icon__icon-wrap">
            {%- if block.settings.icon_image != blank -%}
              {{
                block.settings.icon_image
                | image_url: width: 120
                | image_tag:
                  widths: '60, 90, 120',
                  sizes: '(min-width: 750px) 44px, 32px',
                  loading: 'lazy',
                  alt: block.settings.icon_image.alt
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank -%}
            <h3 class="jf-plain-box-icon__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JF Plain Box Icon",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Items per row on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Items per row on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Book an appointment"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Plain Box Icon",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Book an appointment"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Find a boutique"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Contact us"
          }
        }
      ]
    }
  ]
}
{% endschema %}
