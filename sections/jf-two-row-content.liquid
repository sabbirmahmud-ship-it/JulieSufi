{{ 'section-jf-two-row-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #JfTwoRowContent-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #JfTwoRowContent-{{ section.id }} .jf-two-row-content__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #JfTwoRowContent-{{ section.id }} .jf-two-row-content__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfTwoRowContent-{{ section.id }}" class="jf-two-row-content">
  <div class="jf-two-row-content__inner page-width">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="jf-two-row-content__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="jf-two-row-content__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="jf-two-row-content__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="jf-two-row-content__boxes">
        {%- for block in section.blocks -%}
          <article class="jf-two-row-content__box" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="jf-two-row-content__box-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="jf-two-row-content__box-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footer_text != blank -%}
      <div class="jf-two-row-content__footer rte">{{ section.settings.footer_text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "JF Two Row Content",
  "settings": [
    {
      "type": "header",
      "content": "Top content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Virtual Atelier: Global Access to Melbourne Couture"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Geography is no longer a barrier to the Julie Sufi experience. We collaborate with brides across Australia and overseas, utilising a refined digital architecture to deliver custom wedding dresses from Melbourne to the world.</p>"
    },
    {
      "type": "header",
      "content": "Footer content"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "<p>This collaborative hybrid model ensures that, regardless of your location, you receive the same world-class couture experience and precision engineering synonymous with the finest bespoke wedding gowns in Melbourne.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Font color",
      "default": "#232128"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "content_box",
      "name": "Content box",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Virtual Consultations:"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We guide you through the design evolution in real time via video dialogue. But to let you feel it, we courier premium fabric swatches to your door.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Two Row Content",
      "blocks": [
        {
          "type": "content_box",
          "settings": {
            "heading": "Virtual Consultations:",
            "text": "<p>We guide you through the design evolution in real time via video dialogue. But to let you feel it, we courier premium fabric swatches to your door.</p>"
          }
        },
        {
          "type": "content_box",
          "settings": {
            "heading": "Master-Pattern Integration",
            "text": "<p>We pair our Melbourne atelier's master patterns with trusted local couturiers in your city. Our regular technical oversight ensures the fit meets the rigorous standards of our couture bridal dresses.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
