{{ 'section-jf-insta-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-jf-insta-slider.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign dynamic_feed_enabled = false

  if section.settings.enable_instagram_feed and section.settings.instagram_feed_endpoint != blank
    assign dynamic_feed_enabled = true
  endif

  assign enable_slider = false

  if dynamic_feed_enabled
    if section.settings.instagram_feed_limit > 5
      assign enable_slider = true
    endif
  elsif section.blocks.size > 5
    assign enable_slider = true
  endif
-%}

{%- style -%}
  #JfInstaSlider-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
  }

  #JfInstaSlider-{{ section.id }} .jf-insta-slider__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #JfInstaSlider-{{ section.id }} .jf-insta-slider__track {
    --jf-insta-gap: {{ section.settings.slide_gap }}px;
  }

  @media screen and (min-width: 750px) {
    #JfInstaSlider-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
    }

    #JfInstaSlider-{{ section.id }} .jf-insta-slider__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<jf-insta-slider
  id="JfInstaSlider-{{ section.id }}"
  class="jf-insta-slider"
  {% if dynamic_feed_enabled %}
    data-insta-feed-endpoint="{{ section.settings.instagram_feed_endpoint | escape }}"
    data-insta-feed-limit="{{ section.settings.instagram_feed_limit }}"
    data-insta-feed-handle="{{ section.settings.instagram_feed_handle | escape }}"
    data-insta-section-id="{{ section.id }}"
  {% endif %}
>
  {%- if fallback_background_image != blank -%}
    <div class="jf-insta-slider__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy'
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-insta-slider__inner page-width">
    <div class="jf-insta-slider__intro">
      {%- if section.settings.handle != blank -%}
        <p class="jf-insta-slider__handle">{{ section.settings.handle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="jf-insta-slider__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="jf-insta-slider__viewport">
      <ul class="jf-insta-slider__track list-unstyled{% if enable_slider %} jf-insta-slider__track--slider{% else %} jf-insta-slider__track--grid{% endif %}" data-insta-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign manual_image = block.settings.image
            assign instagram_image_url = block.settings.instagram_image_url | strip
            assign slide_alt = block.settings.image_alt | default: manual_image.alt | default: section.settings.heading
          -%}
          <li class="jf-insta-slider__slide" data-insta-slide {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="jf-insta-slider__link">
            {%- else -%}
              <div class="jf-insta-slider__card">
            {%- endif -%}
              <div class="jf-insta-slider__media">
                {%- if manual_image != blank -%}
                  {{
                    manual_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '375, 550, 750, 900, 1100, 1200',
                      sizes: '(min-width: 750px) 20vw, 48vw',
                      loading: 'lazy',
                      alt: slide_alt
                  }}
                {%- elsif instagram_image_url != blank -%}
                  <img
                    src="{{ instagram_image_url | escape }}"
                    alt="{{ slide_alt | escape }}"
                    loading="lazy"
                    sizes="(min-width: 750px) 20vw, 48vw"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if enable_slider -%}
        <div class="jf-insta-slider__controls">
          <button type="button" class="jf-insta-slider__arrow jf-insta-slider__arrow--prev" data-insta-prev aria-label="Previous slide">
            <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </button>
          <div class="jf-insta-slider__dots" data-insta-dots></div>
          <button type="button" class="jf-insta-slider__arrow jf-insta-slider__arrow--next" data-insta-next aria-label="Next slide">
            <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="jf-insta-slider__cta">
        <a
          {% if section.settings.cta_link != blank %}
            href="{{ section.settings.cta_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="jf-insta-slider__cta-link"
        >
          {{ section.settings.cta_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</jf-insta-slider>

{% schema %}
{
  "name": "JF Insta Slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@JULIESUFI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real brides. Real moments."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bottom link label",
      "default": "Follow Us On Instagram"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bottom link"
    },
    {
      "type": "header",
      "content": "Instagram Feed"
    },
    {
      "type": "checkbox",
      "id": "enable_instagram_feed",
      "label": "Enable automatic Instagram feed",
      "default": false,
      "info": "Requires a Shopify app proxy or backend endpoint that returns the latest Instagram posts as JSON."
    },
    {
      "type": "text",
      "id": "instagram_feed_endpoint",
      "label": "Feed endpoint",
      "info": "Example: /apps/instagram-feed"
    },
    {
      "type": "text",
      "id": "instagram_feed_handle",
      "label": "Instagram handle",
      "info": "Optional. Sent to the endpoint so the backend can choose which account to load."
    },
    {
      "type": "range",
      "id": "instagram_feed_limit",
      "label": "Posts to load",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between slides",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "instagram_image_url",
          "label": "Instagram image URL",
          "info": "Optional. Use this when the image should be loaded from an external Instagram feed URL instead of Shopify files."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Insta Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
