{{ 'section-jf-all-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
-%}

{%- style -%}
  #JfAllCollection-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
  }

  #JfAllCollection-{{ section.id }} .jf-all-collection__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #JfAllCollection-{{ section.id }} .jf-all-collection__grid {
    --jf-all-collection-columns-mobile: {{ section.settings.columns_mobile }};
    --jf-all-collection-columns-desktop: {{ section.settings.columns_desktop }};
  }

  @media screen and (min-width: 750px) {
    #JfAllCollection-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    #JfAllCollection-{{ section.id }} .jf-all-collection__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfAllCollection-{{ section.id }}" class="jf-all-collection">
  {%- if fallback_background_image != blank -%}
    <div class="jf-all-collection__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy'
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-all-collection__inner page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
      <div class="jf-all-collection__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="jf-all-collection__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="jf-all-collection__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="jf-all-collection__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="jf-all-collection__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- if collection != blank and collection.handle != 'frontpage' and collection.handle != 'all' -%}
          <li class="jf-all-collection__item" {{ block.shopify_attributes }}>
            <article class="jf-all-collection__card">
              <a href="{{ collection.url }}" class="jf-all-collection__media-link">
                <div class="jf-all-collection__media">
                  {%- if collection.featured_image != blank -%}
                    {{
                      collection.featured_image
                      | image_url: width: 1800
                      | image_tag:
                        widths: '375, 550, 750, 900, 1100, 1400, 1800',
                        sizes: '(min-width: 750px) calc((100vw - 8rem) / 2), 100vw',
                        loading: 'lazy',
                        alt: collection.title
                    }}
                  {%- elsif collection.products.first != blank and collection.products.first.featured_media != blank -%}
                    {{
                      collection.products.first.featured_media
                      | image_url: width: 1800
                      | image_tag:
                        widths: '375, 550, 750, 900, 1100, 1400, 1800',
                        sizes: '(min-width: 750px) calc((100vw - 8rem) / 2), 100vw',
                        loading: 'lazy',
                        alt: collection.title
                    }}
                  {%- else -%}
                    {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </a>

              <div class="jf-all-collection__content">
                <h3 class="jf-all-collection__title">
                  <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
                </h3>

                {%- if section.settings.button_label != blank -%}
                  <div class="jf-all-collection__button-wrap">
                    <a href="{{ collection.url }}" class="jf-all-collection__button">
                      <span>{{ section.settings.button_label | escape }}</span>
                      <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "JF All Collection",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Bridal Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "JULIE SUFI"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A refined expression of modern romance and timeless couture, the Julie Sufi Bridal Collection is crafted for the bride who values detail, individuality, and elegance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "VIEW COLLECTION"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop items per row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile items per row",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Mobile top margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Mobile bottom margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Desktop top margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Desktop bottom margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF All Collection",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
