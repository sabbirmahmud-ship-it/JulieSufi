{{ 'section-jf-logo-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign enable_slider = false

  if section.blocks.size > 6
    assign enable_slider = true
  endif
-%}

{%- style -%}
  #JfLogoSlider-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
  }

  #JfLogoSlider-{{ section.id }} .jf-logo-slider__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #JfLogoSlider-{{ section.id }} .jf-logo-slider__track {
    --jf-logo-gap: {{ section.settings.logo_gap }}px;
  }

  #JfLogoSlider-{{ section.id }} .jf-logo-slider__logo img,
  #JfLogoSlider-{{ section.id }} .jf-logo-slider__logo .placeholder-svg {
    --jf-logo-height-mobile: {{ section.settings.logo_height_mobile }}px;
    --jf-logo-height-desktop: {{ section.settings.logo_height_desktop }}px;
  }

  @media screen and (min-width: 750px) {
    #JfLogoSlider-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
    }

    #JfLogoSlider-{{ section.id }} .jf-logo-slider__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfLogoSlider-{{ section.id }}" class="jf-logo-slider">
  {%- if fallback_background_image != blank -%}
    <div class="jf-logo-slider__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy'
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-logo-slider__inner page-width">
    <div class="jf-logo-slider__bar">
      {%- if section.settings.heading != blank -%}
        <p class="jf-logo-slider__heading">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      <div class="jf-logo-slider__viewport">
        <ul class="jf-logo-slider__track list-unstyled{% if enable_slider %} jf-logo-slider__track--slider{% endif %}">
          {%- for block in section.blocks -%}
            <li class="jf-logo-slider__slide" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="jf-logo-slider__link">
              {%- else -%}
                <div class="jf-logo-slider__link">
              {%- endif -%}
                <span class="jf-logo-slider__logo">
                  {%- if block.settings.logo != blank -%}
                    {{
                      block.settings.logo
                      | image_url: width: 500
                      | image_tag:
                        widths: '120, 180, 260, 360, 500',
                        sizes: '(min-width: 750px) 12vw, 28vw',
                        loading: 'lazy',
                        alt: block.settings.logo.alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JF Logo Slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured In"
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Mobile logo height",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Desktop logo height",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Logo link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JF Logo Slider",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
