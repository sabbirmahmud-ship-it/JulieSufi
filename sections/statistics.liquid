{{ 'section-statistics.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #Statistics-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
  }

  #Statistics-{{ section.id }} .statistics__inner {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #Statistics-{{ section.id }} .statistics__grid {
    --statistics-columns-mobile: {{ section.settings.columns_mobile }};
    --statistics-columns-desktop: {{ section.settings.columns_desktop }};
    --statistics-column-gap: {{ section.settings.column_gap }}px;
    --statistics-row-gap: {{ section.settings.row_gap }}px;
  }

  @media screen and (min-width: 750px) {
    #Statistics-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
    }

    #Statistics-{{ section.id }} .statistics__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section id="Statistics-{{ section.id }}" class="statistics">
  {%- if fallback_background_image != blank -%}
    <div class="statistics__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            fetchpriority: fetch_priority
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="statistics__inner page-width">
    <div class="statistics__grid">
      {%- for block in section.blocks -%}
        <div class="statistics__item" {{ block.shopify_attributes }}>
          {%- if block.settings.value != blank -%}
            <div class="statistics__value">{{ block.settings.value }}</div>
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            <div class="statistics__label">{{ block.settings.label }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Statistics",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Items per row on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Items per row on mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between items",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#f3f1ed"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#f3f1ed"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "value",
          "label": "Value",
          "default": "300+"
        },
        {
          "type": "richtext",
          "id": "label",
          "label": "Label",
          "default": "<p>Brides Worldwide</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Statistics",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "300+",
            "label": "<p>Brides Worldwide</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "10+",
            "label": "<p>Years of Couture</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "<p>Handcrafted</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Melbourne",
            "label": "<p>Atelier</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
