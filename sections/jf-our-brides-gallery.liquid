{{ 'section-jf-our-brides-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-jf-our-brides.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_background_image = section.settings.desktop_background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: desktop_background_image
  assign fallback_background_image = desktop_background_image | default: mobile_background_image
  assign gallery_source_mode = section.settings.gallery_source | default: 'auto'
  assign metafield_namespace = section.settings.gallery_metafield_namespace | strip
  assign metafield_key = section.settings.gallery_metafield_key | strip
  assign gallery_metafield = blank
  assign gallery_images = blank
  assign has_gallery_images = false
  assign use_manual_blocks = true
  assign gallery_blocks = section.blocks
  assign fetch_priority = 'auto'
  assign show_share_button = false

  if gallery_source_mode != 'manual' and metafield_namespace != blank and metafield_key != blank
    if page != blank and page.metafields[metafield_namespace] != blank and page.metafields[metafield_namespace][metafield_key] != blank
      assign gallery_metafield = page.metafields[metafield_namespace][metafield_key]
    elsif shop.metafields[metafield_namespace] != blank and shop.metafields[metafield_namespace][metafield_key] != blank
      assign gallery_metafield = shop.metafields[metafield_namespace][metafield_key]
    endif

    if gallery_metafield != blank and gallery_metafield.value != blank
      assign gallery_images = gallery_metafield.value
      assign has_gallery_images = true
      assign use_manual_blocks = false
    elsif gallery_source_mode == 'metafield'
      assign use_manual_blocks = false
    endif
  endif

  if section.settings.cards_order == 'reverse'
    if gallery_images != blank
      assign gallery_images = gallery_images | reverse
    endif

    assign gallery_blocks = gallery_blocks | reverse
  endif

  if gallery_source_mode == 'manual'
    assign use_manual_blocks = true
  endif

  if section.settings.show_share_button and section.settings.button_label != blank
    assign show_share_button = true
  endif

  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #JfOurBridesGallery-{{ section.id }} {
    background-color: {{ section.settings.mobile_background_color }};
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    --jf-our-brides-columns-mobile: {{ section.settings.columns_mobile }};
    --jf-our-brides-columns-desktop: {{ section.settings.columns_desktop }};
  }

  #JfOurBridesGallery-{{ section.id }} .jf-our-brides__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #JfOurBridesGallery-{{ section.id }} {
      background-color: {{ section.settings.desktop_background_color }};
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    #JfOurBridesGallery-{{ section.id }} .jf-our-brides__inner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="JfOurBridesGallery-{{ section.id }}" class="jf-our-brides">
  {%- if fallback_background_image != blank -%}
    <div class="jf-our-brides__background">
      <picture>
        {%- if mobile_background_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_background_image | image_url: width: 375 }} 375w,
              {{ mobile_background_image | image_url: width: 550 }} 550w,
              {{ mobile_background_image | image_url: width: 750 }} 750w,
              {{ mobile_background_image | image_url: width: 900 }} 900w,
              {{ mobile_background_image | image_url: width: 1200 }} 1200w,
              {{ mobile_background_image | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_background_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1780, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            fetchpriority: fetch_priority
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="jf-our-brides__inner page-width">
    <jf-our-brides
      class="jf-our-brides__content"
      data-items-per-page-mobile="{{ section.settings.items_per_page_mobile }}"
      data-items-per-page-desktop="{{ section.settings.items_per_page_desktop }}"
      data-section-id="{{ section.id }}"
    >
      <div class="jf-our-brides__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="jf-our-brides__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="jf-our-brides__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- if show_share_button -%}
        <div class="jf-our-brides__actions">
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="jf-our-brides__button"
          >
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}

      <div class="jf-our-brides__grid-wrapper{% unless show_share_button %} jf-our-brides__grid-wrapper--no-actions{% endunless %}">
        <div class="jf-our-brides__grid" data-items>
          {%- if has_gallery_images -%}
            {%- for gallery_image in gallery_images -%}
              {%- liquid
                assign image_loading = 'lazy'
                assign gallery_image_alt = gallery_image.alt | default: section.settings.heading

                if forloop.index <= section.settings.items_per_page_desktop
                  assign image_loading = 'eager'
                endif
              -%}

              <article
                class="jf-our-brides__card"
                data-page-item
                data-block-id="metafield-image-{{ forloop.index0 }}"
              >
                <div class="jf-our-brides__card-link">
                  <div class="jf-our-brides__media">
                    {%- if gallery_image != blank -%}
                      {{
                        gallery_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '275, 420, 550, 720, 900, 1200',
                          sizes: '(min-width: 750px) 33vw, 100vw',
                          loading: image_loading,
                          alt: gallery_image_alt
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          {%- elsif use_manual_blocks -%}
            {%- for block in gallery_blocks -%}
              {%- liquid
                assign image_loading = 'lazy'
                assign gallery_image_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.heading

                if forloop.index <= section.settings.items_per_page_desktop
                  assign image_loading = 'eager'
                endif
              -%}

              <article
                class="jf-our-brides__card"
                data-page-item
                data-block-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="jf-our-brides__card-link">
                {%- else -%}
                  <div class="jf-our-brides__card-link">
                {%- endif -%}
                    <div class="jf-our-brides__media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 1200
                          | image_tag:
                            widths: '275, 420, 550, 720, 900, 1200',
                            sizes: '(min-width: 750px) 33vw, 100vw',
                            loading: image_loading,
                            alt: gallery_image_alt
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="jf-our-brides__empty{% if has_gallery_images or section.blocks.size > 0 %} hidden{% endif %}">
          Add gallery image blocks or connect a gallery metafield to populate this section.
        </div>
      </div>

      <div class="jf-our-brides__pagination" data-pagination hidden>
        <nav class="jf-our-brides__pagination-nav" aria-label="Our brides gallery pagination">
          <button
            type="button"
            class="jf-our-brides__pagination-arrow"
            data-pagination-prev
            aria-label="Previous page"
          >
            &lt;
          </button>
          <div class="jf-our-brides__pagination-pages" data-pagination-pages></div>
          <button
            type="button"
            class="jf-our-brides__pagination-arrow"
            data-pagination-next
            aria-label="Next page"
          >
            &gt;
          </button>
        </nav>
      </div>
    </jf-our-brides>
  </div>
</section>

{% schema %}
{
  "name": "JF Our Brides Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR BRIDES"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Welcome to Julie Sufi Bridal - a modern atelier of timeless elegance and modern romance, brought to life by our real brides. We'd be honoured to feature your love story and wedding day moments - share your images with us and join the Julie Sufi Bridal journey.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_share_button",
      "label": "Show share button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHARE YOUR WEDDING"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "gallery_source",
      "label": "Gallery source",
      "options": [
        {
          "value": "auto",
          "label": "Metafield first, then manual blocks"
        },
        {
          "value": "metafield",
          "label": "Metafield only"
        },
        {
          "value": "manual",
          "label": "Manual blocks only"
        }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "gallery_metafield_namespace",
      "label": "Gallery metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "gallery_metafield_key",
      "label": "Gallery metafield key",
      "default": "jf_our_brides_gallery_images"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop items per row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile items per row",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "items_per_page_desktop",
      "label": "Desktop items per page",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "items_per_page_mobile",
      "label": "Mobile items per page",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "cards_order",
      "label": "Card display order",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "reverse",
          "label": "Reverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Top margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Bottom margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Top margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Bottom margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "JF Our Brides Gallery",
      "blocks": [
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        }
      ]
    }
  ]
}
{% endschema %}
