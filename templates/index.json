    "jf_faq_BHYQwi": {
      "type": "jf-faq",
      "blocks": {
        "item_Ld4Wgx": {
          "type": "item",
          "settings": {
            "question": "Where is the Julie Sufi bridal atelier located?",
            "answer": "Our private bridal atelier is located in Northcote, Melbourne, Australia. Unlike a traditional wedding dress store in Melbourne, we provide a quiet, designer-led sanctuary away from the busy retail floor. Whether you are traveling from the Melbourne CBD or interstate, every consultation is a private, unhurried experience with Julie herself. We welcome you to experience Julie Sufi for your custom wedding dresses.",
            "open_by_default": false
          }
        },
        "item_6qxTym": {
          "type": "item",
          "settings": {
            "question": "How many fittings are included with a custom wedding gown?",
            "answer": "Every Julie Sufi commission includes a dedicated series of precision fittings to ensure a flawless, second-skin fit. Your journey includes an initial design dialogue, a mid-construction fitting, and a final walkthrough before your day. As one of the leading wedding boutiques in Melbourne, we offer additional adjustments as required at no extra charge, ensuring your custom wedding dress is structurally and aesthetically perfect.",
            "open_by_default": true
          }
        },
        "item_EKchFE": {
          "type": "item",
          "settings": {
            "question": "Do you offer virtual consultations for brides outside Melbourne?",
            "answer": "Yes, we frequently collaborate with brides across Australia and overseas. Through immersive virtual consultations, we guide you through the design process, couriering premium fabric swatches to your door. By pairing our Melbourne atelier’s master patterns with trusted local seamstresses in your city, we ensure the same world-class couture experience synonymous with the finest wedding gowns in Melbourne, Australia, regardless of your location.",
            "open_by_default": false
          }
        },
        "item_j8pLCC": {
          "type": "item",
          "settings": {
            "question": "What is the investment for a custom Julie Sufi wedding gown?",
            "answer": "Every Julie Sufi wedding gown is a singular investment in world-class silks and artisanal heritage. Our bespoke couture starts from AU$6,000, with high-couture designs featuring hand-embroidery or complex construction ranging from AU$8,000 to AU$20,000+. As a leading wedding dress store in Melbourne, we provide a transparent, defined investment structure from your very first sketch, ensuring absolute clarity without hidden costs.",
            "open_by_default": false
          }
        },
        "item_wJkgtR": {
          "type": "item",
          "settings": {
            "question": "How far in advance should I book my initial consultation?",
            "answer": "To ensure the meticulous hand-finishing your wedding gown in Melbourne deserves, we recommend a ‘Golden Window’ of 6 to 9 months. This timeframe allows for precision fabric sourcing from international mills and multiple muslin mock-ups. However, for brides with a shorter timeline, our Melbourne atelier can occasionally accommodate express couture commissions depending on the complexity of the vision.",
            "open_by_default": false
          }
        },
        "item_H43em8": {
          "type": "item",
          "settings": {
            "question": "Can I bring reference images or a specific vision to my appointment?",
            "answer": "<p>Absolutely, you can. Your reference image becomes a bridge between your spirit and our craft. While we don't replicate other designers, your inspiration is the blueprint for our collaboration. Whether you have a Pinterest board of minimalist wedding dresses or a family heirloom you wish to incorporate, Julie Sufi works to translate your references into a signature wedding dress.</p>",
            "open_by_default": false
          }
        }
      },
