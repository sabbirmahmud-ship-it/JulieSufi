    "jf_faq_dCMHqN": {
      "type": "jf-faq",
      "blocks": {
        "item_rJmwNd": {
          "type": "item",
          "settings": {
            "question": "The Philosophy: Custom vs Ready-to-Wear",
            "answer": "<p dir=\"ltr\"><span>In the world of bridal architecture, there are two distinct paths:</span></p>\n<ul>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>Ready-to-Wear:</strong><span> </span><span>Designed for the many. </span><span><br></span><span>These standard-sized silhouettes offer an efficient 3 to 4-month timeline. While accessible, they often require structural alterations to mimic a true fit.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<strong>The Julie Sufi Couture Wedding Gown:</strong> Designed for the one. <br>Beginning with a blank page and your unique geometry, we build a gown that exists nowhere else. It is an investment in uncompromising fit, world-class silks, and artisanal identity.</li>\n</ul>\n<p> </p>",
            "open_by_default": true
          }
        },
        "item_KKVJ8F": {
          "type": "item",
          "settings": {
            "question": "The Investment Landscape",
            "answer": "<p class=\"MsoNormal\"><meta charset=\"utf-8\">Transparency is the cornerstone of a luxury experience. Understanding the Julie Dufi pricing allows for a confident, informed decision.</p>\n<table class=\"MsoNormalTable\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-top: 10px; width: 100%; background: rgb(245, 240, 232); height: 275.938px;\">\n<thead style=\"background: black; color: white;\">\n<tr style=\"height: 55.1875px;\">\n<td style=\"padding: 10.5pt 15pt; height: 55.1875px; width: 23.8351%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\">Category</span></p>\n</td>\n<td style=\"padding: 10.5pt 15pt; height: 55.1875px; width: 24.1935%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\">Price Range (AUD)</span></p>\n</td>\n<td style=\"padding: 10.5pt 15pt; height: 55.1875px; width: 52.1505%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">\n<b id=\"docs-internal-guid-18236860-7fff-3266-4c11-d8cefd6568e6\"><span>What You Get</span></b></span></p>\n</td>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 55.1875px;\">\n<td style=\"border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor rgb(232, 226, 217); border-image: initial; padding: 10.5pt 15pt; height: 55.1875px; width: 23.8351%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">\n<strong>Bespoke Couture</strong></span></p>\n</td>\n<td style=\"border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor rgb(232, 226, 217); border-image: initial; padding: 10.5pt 15pt; height: 55.1875px; width: 24.1935%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">$6,000–$12,000+</span></p>\n</td>\n<td style=\"border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor rgb(232, 226, 217); border-image: initial; padding: 10.5pt 15pt; height: 55.1875px; width: 52.1505%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">Original design, premium silks, 1-on-1 designer access.</span></p>\n</td>\n</tr>\n<tr style=\"height: 55.1875px;\">\n<td style=\"border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor rgb(232, 226, 217); border-image: initial; padding: 10.5pt 15pt; height: 55.1875px; width: 23.8351%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">\n<b id=\"docs-internal-guid-9e70264a-7fff-6471-8bb8-20b40cf5d37b\"><span>High Couture</span></b></span></p>\n</td>\n<td style=\"border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor rgb(232, 226, 217); border-image: initial; padding: 10.5pt 15pt; height: 55.1875px; width: 24.1935%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">$8,000–$20,000+</span></p>\n</td>\n<td style=\"border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor rgb(232, 226, 217); border-image: initial; padding: 10.5pt 15pt; height: 55.1875px; width: 52.1505%;\">\n<p class=\"MsoNormal\"><span lang=\"EN-AU\"><meta charset=\"utf-8\">Hand-embroidery, imported laces, complex construction</span></p>\n</td>\n</tr>\n</tbody>\n</table>",
            "open_by_default": false
          }
        },
        "item_fNHwFP": {
          "type": "item",
          "settings": {
            "question": "Signature Melbourne Silhouettes",
            "answer": "<p dir=\"ltr\"><span>Melbourne brides are renowned for a style that is both avant-garde and timeless. We focus on six iconic forms defining the modern aisle:</span></p>\n<ul>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>The Architectural A-Line:</strong><span> Universally flattering; a study in balance and grace.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>The Sculptural Fishtail:</strong><span> Body-conscious and dramatic; a favourite for high-fashion statements.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>The Grand Ballgown:</strong><span> Voluminous and regal; designed for Melbourne’s heritage cathedrals.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>The Minimalist Slip:</strong><span> Bias-cut liquid silk; the epitome of contemporary chic.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>The Romantic Long-Sleeve:</strong><span> Refined lace and sheer coverage; a seasonal favourite.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>The Modern Two-Piece:</strong><span> Versatile and edgy; for the bride who breaks from tradition.</span></p>\n</li>\n</ul>\n<p> </p>",
            "open_by_default": false
          }
        },
        "item_WFXYTj": {
          "type": "item",
          "settings": {
            "question": "The Temporal Luxury: Your Timeline",
            "answer": "Time is the most critical element of couture. To ensure the meticulous hand-finishing your wedding gown deserves, we recommend the ‘Golden Window’ of 6 to 9 months. This allows for meticulous fabric sourcing, muslin mock-ups, and the series of precision fittings required for a flawless, second-skin finish",
            "open_by_default": false
          }
        },
        "item_UpGjLV": {
          "type": "item",
          "settings": {
            "question": "Vetting Your Designer",
            "answer": "<p dir=\"ltr\"><span>When visiting a wedding dress store in Melbourne, ensure your experience meets these luxury benchmarks:</span></p>\n<ol>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>Direct Designer Access:</strong><span> You should collaborate with the designer, not just a sales consultant.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>Portfolio Consistency:</strong><span> Look for signature artistry that resonates with your personal aesthetic.</span></p>\n</li>\n<li dir=\"ltr\" aria-level=\"1\">\n<p dir=\"ltr\" role=\"presentation\"><strong>Process Transparency:</strong><span> A reputable atelier provides clear, upfront investment figures without hidden costs.</span></p>\n</li>\n</ol>\n<p> </p>",
            "open_by_default": false
          }
        },
        "item_RCGRfG": {
          "type": "item",
          "settings": {
            "question": "Begin Your Journey",
            "answer": "<p>Experience the difference of a vision-led design process. We invite you to the Julie Sufi Melbourne atelier for a complimentary consultation to discuss your dream wedding gown.</p>",
            "open_by_default": false
          }
        }
      },
