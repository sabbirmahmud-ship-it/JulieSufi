    "jf_faq_BHYQwi": {
      "type": "jf-faq",
      "blocks": {
        "item_Ld4Wgx": {
          "type": "item",
          "settings": {
            "question": "Where is the Julie Sufi bridal atelier located in Melbourne?",
            "answer": "<p>Our bridal atelier is located in Northcote, Victoria, Australia. All appointments are by arrangement — we do not run a busy boutique floor. Every consultation is a private, unhurried experience with Julie herself. Whether you are searching for wedding dresses in Melbourne CBD, the inner suburbs, or simply want to work with the best custom wedding dress designer in Melbourne, we welcome you to come and experience the Julie Sufi difference. Please contact us or book online to schedule your private consultation.</p>",
            "open_by_default": false
          }
        },
        "item_6qxTym": {
          "type": "item",
          "settings": {
            "question": "Do you offer custom-made bridal gowns?",
            "answer": "<p>Yes. Every Julie Sufi gown is custom-made and designed in collaboration with the bride.</p>",
            "open_by_default": true
          }
        },
        "item_EKchFE": {
          "type": "item",
          "settings": {
            "question": "How long does it take to create a custom wedding dress in Melbourne?",
            "answer": "<p>A custom couture wedding dress at Julie Sufi Couture typically takes between 4 to 6 months from initial consultation to final fitting. We recommend booking your consultation at least 6–9 months before your wedding date to allow ample time for design, fabric sourcing, and multiple fittings. Rush timelines may be possible — please contact us to discuss your specific situation.</p>",
            "open_by_default": false
          }
        },
        "item_j8pLCC": {
          "type": "item",
          "settings": {
            "question": "What is the price range for a Julie Sufi custom wedding dress?",
            "answer": "<p>Our custom bridal gowns start from $5,000 AUD. The final price depends on the complexity of the design, fabric selection, and embellishment work. We offer a complimentary consultation to discuss your vision and provide a personalised quote with no obligation.</p>",
            "open_by_default": false
          }
        },
        "item_wJkgtR": {
          "type": "item",
          "settings": {
            "question": "How many fittings are included with a custom wedding dress?",
            "answer": "<p>Every Julie Sufi custom wedding gown includes a minimum of three fittings: an initial design consultation, a mid-construction fitting, and a final fitting before delivery. Additional fittings can be arranged as needed at no extra charge to ensure your gown fits perfectly on your wedding day.</p>",
            "open_by_default": false
          }
        },
        "item_H43em8": {
          "type": "item",
          "settings": {
            "question": "Do you offer virtual consultations for brides outside Melbourne?",
            "answer": "<p>Yes. We offer virtual consultations for brides located outside Melbourne or interstate. Our team will guide you through the design process, fabric swatches can be posted to you, and we work with trusted local seamstresses for fittings in your city. Many of our most beautiful custom wedding dresses have been created for interstate brides.</p>",
            "open_by_default": false
          }
        }
      },
