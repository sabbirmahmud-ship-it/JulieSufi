        "cost_row_44UqpV": {
          "type": "cost_row",
          "settings": {
            "image": "shopify://shop_images/Rectangle_22944.png",
            "image_position": "left",
            "heading": "Begin with the Final Cost",
            "price": "Starting from AU$5,000",
            "description": "<p>One of the most significant benefits of the couture path is the elimination of the hidden costs associated with traditional bridal boutiques.</p>",
            "feature_1_heading": "Starting from AU$8,000",
            "feature_1_text": "<p>Standard bridal shops often charge between AU$800 and AU$1,500 for post-purchase alterations. At Julie Sufi, your gown is built to your measurements from day one.</p>",
            "feature_2_heading": "Unlimited Fittings",
            "feature_2_text": "<p>Your first price outline includes every fitting required-from the initial calico Toile mock-up to the final silk refinement.</p>",
            "feature_3_heading": "Direct Accountability",
            "feature_3_text": "<p>You are not paying for showroom markups or retail overhead. Every dollar of your investment stays within our Melbourne atelier, and so does the responsibility for the master-craftsmanship of your custom wedding dress.</p>"
          }
        }
