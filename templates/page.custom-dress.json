          "settings": {
            "icon_image": "shopify://shop_images/Group_1000013456.png",
            "title": "The Express Protocol: Under 4 Months",
            "text": "<p>For weddings occurring in less than four months, we offer an express protocol. This accelerated path reallocates our available Melbourne atelier resources to maintain our signature structural integrity, ensuring your custom wedding dress is delivered without compromising the Maker’s Mark.<br/><br/></p>"
          }
        },
        "item_VxMXbU": {
